{
  "entities": {
    "Trainer": {
      "title": "Trainer",
      "description": "Institute trainer profile displayed on the portal home page.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "designation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "branches": {
          "type": "array",
          "description": "1 to 2 branch identifiers handled by this trainer."
        },
        "branchSchedules": {
          "type": "object",
          "description": "Display schedule days per branch."
        },
        "softwares": {
          "type": "array",
          "description": "Bounded list (max 20) of software short names handled by this trainer."
        },
        "ongoingCount": {
          "type": "number"
        },
        "completedCount": {
          "type": "number"
        },
        "attendanceCount": {
          "type": "number"
        },
        "dashboardConfigured": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "designation",
        "branches",
        "branchSchedules",
        "softwares",
        "ongoingCount",
        "completedCount",
        "attendanceCount",
        "dashboardConfigured",
        "createdAt",
        "updatedAt"
      ]
    },
    "TrainerCredentials": {
      "title": "TrainerCredentials",
      "description": "Salted SHA-256 passkey and recovery secret hashes for trainer passkey access.",
      "type": "object",
      "properties": {
        "trainerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "passkeyHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 128
        },
        "recoveryQuestion": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "recoveryAnswerHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "trainerId",
        "passkeyHash",
        "recoveryQuestion",
        "recoveryAnswerHash",
        "createdAt",
        "updatedAt"
      ]
    },
    "Course": {
      "title": "Course",
      "description": "Trainer-scoped course definition with duration and software modules.",
      "type": "object",
      "properties": {
        "trainerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "durationValue": {
          "type": "number"
        },
        "durationUnit": {
          "type": "string",
          "enum": ["days", "weeks", "months"]
        },
        "durationDays": {
          "type": "number"
        },
        "softwares": {
          "type": "array",
          "description": "Bounded list (max 12) of { fullName, shortName } objects."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "trainerId",
        "shortName",
        "fullName",
        "durationValue",
        "durationUnit",
        "durationDays",
        "softwares",
        "createdAt",
        "updatedAt"
      ]
    },
    "Student": {
      "title": "Student",
      "description": "Trainer-scoped student admission record with optional Reg. No. and dual-course support.",
      "type": "object",
      "properties": {
        "trainerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "regNo": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "branch": {
          "type": "string",
          "enum": ["MAVELIKARA", "KAYAMKULAM"]
        },
        "course1Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "course1Short": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "course1Full": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "course1DurationDays": {
          "type": "number"
        },
        "course2Id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "course2Short": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "course2Full": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "course2DurationDays": {
          "type": "number"
        },
        "totalDurationDays": {
          "type": "number"
        },
        "joiningDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "examDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "contact": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "completedSoftwares": {
          "type": "array",
          "description": "Bounded list (max 24) of completed software identifiers."
        },
        "status": {
          "type": "string",
          "enum": ["ongoing", "completed"]
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "trainerId",
        "regNo",
        "name",
        "branch",
        "course1Id",
        "course1Short",
        "course1Full",
        "course1DurationDays",
        "course2Id",
        "course2Short",
        "course2Full",
        "course2DurationDays",
        "totalDurationDays",
        "joiningDate",
        "examDate",
        "contact",
        "completedSoftwares",
        "status",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily attendance status entry for a student on a specific calendar date.",
      "type": "object",
      "properties": {
        "trainerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "branch": {
          "type": "string",
          "enum": ["MAVELIKARA", "KAYAMKULAM"]
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["present", "absent", "late", "excused"]
        },
        "remark": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "trainerId",
        "studentId",
        "branch",
        "date",
        "status",
        "remark",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/trainers/{trainerId}": {
      "schema": { "$ref": "#/entities/Trainer" },
      "description": "Trainer directory cards shown on the home page."
    },
    "/trainers/{trainerId}/credentials/{credId}": {
      "schema": { "$ref": "#/entities/TrainerCredentials" },
      "description": "Hashed passkey and recovery question/answer for each trainer."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Courses created by each trainer."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student admissions created and managed by each trainer."
    },
    "/students/{studentId}/attendance/{dateStr}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Daily attendance records nested under each student."
    }
  }
}
