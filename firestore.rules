rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidOptionalDateStr(d) {
      return d is string && (d == '' || isValidDateStr(d));
    }

    function isValidTrainer(data) {
      return data.keys().hasAll([
          'name', 'designation', 'branches', 'branchSchedules', 'softwares',
          'ongoingCount', 'completedCount', 'attendanceCount',
          'dashboardConfigured', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'designation', 'branches', 'branchSchedules', 'softwares',
          'ongoingCount', 'completedCount', 'attendanceCount',
          'dashboardConfigured', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.designation is string && data.designation.size() >= 1 && data.designation.size() <= 100
        && data.branches is list && data.branches.size() >= 1 && data.branches.size() <= 2
        && data.branches.hasOnly(['MAVELIKARA', 'KAYAMKULAM'])
        && data.branchSchedules is map
        && data.branchSchedules.keys().hasOnly(['MAVELIKARA', 'KAYAMKULAM'])
        && data.softwares is list && data.softwares.size() <= 20
        && (data.softwares.size() == 0 || (data.softwares[0] is string && data.softwares[0].size() <= 40))
        && data.ongoingCount is number && data.ongoingCount >= 0 && data.ongoingCount <= 100000
        && data.completedCount is number && data.completedCount >= 0 && data.completedCount <= 100000
        && data.attendanceCount is number && data.attendanceCount >= 0 && data.attendanceCount <= 1000000
        && data.dashboardConfigured is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrainerCredentials(data, trainerId) {
      return data.keys().hasAll([
          'trainerId', 'passkeyHash', 'recoveryQuestion', 'recoveryAnswerHash',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'trainerId', 'passkeyHash', 'recoveryQuestion', 'recoveryAnswerHash',
          'createdAt', 'updatedAt'
        ])
        && data.trainerId is string && data.trainerId == trainerId
        && data.passkeyHash is string && data.passkeyHash.size() == 64
        && data.recoveryQuestion is string && data.recoveryQuestion.size() >= 3 && data.recoveryQuestion.size() <= 160
        && data.recoveryAnswerHash is string && data.recoveryAnswerHash.size() == 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourse(data) {
      return data.keys().hasAll([
          'trainerId', 'shortName', 'fullName', 'durationValue',
          'durationUnit', 'durationDays', 'softwares', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'trainerId', 'shortName', 'fullName', 'durationValue',
          'durationUnit', 'durationDays', 'softwares', 'createdAt', 'updatedAt'
        ])
        && data.trainerId is string && isValidId(data.trainerId)
        && data.shortName is string && data.shortName.size() >= 1 && data.shortName.size() <= 30
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 160
        && data.durationValue is number && data.durationValue >= 1 && data.durationValue <= 1825
        && data.durationUnit in ['days', 'weeks', 'months']
        && data.durationDays is number && data.durationDays >= 1 && data.durationDays <= 1825
        && data.softwares is list && data.softwares.size() >= 1 && data.softwares.size() <= 12
        && data.softwares[0] is map
        && data.softwares[0].keys().hasAll(['fullName', 'shortName'])
        && data.softwares[0].keys().hasOnly(['fullName', 'shortName'])
        && data.softwares[0].fullName is string && data.softwares[0].fullName.size() >= 1 && data.softwares[0].fullName.size() <= 100
        && data.softwares[0].shortName is string && data.softwares[0].shortName.size() >= 1 && data.softwares[0].shortName.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll([
          'trainerId', 'regNo', 'name', 'branch', 'course1Id', 'course1Short', 'course1Full',
          'course1DurationDays', 'course2Id', 'course2Short', 'course2Full',
          'course2DurationDays', 'totalDurationDays', 'joiningDate', 'examDate',
          'contact', 'completedSoftwares', 'status', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'trainerId', 'regNo', 'name', 'branch', 'course1Id', 'course1Short', 'course1Full',
          'course1DurationDays', 'course2Id', 'course2Short', 'course2Full',
          'course2DurationDays', 'totalDurationDays', 'joiningDate', 'examDate',
          'contact', 'completedSoftwares', 'status', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.trainerId is string && isValidId(data.trainerId)
        && data.regNo is string && data.regNo.size() <= 40
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.branch in ['MAVELIKARA', 'KAYAMKULAM']
        && data.course1Id is string && isValidId(data.course1Id)
        && data.course1Short is string && data.course1Short.size() >= 1 && data.course1Short.size() <= 30
        && data.course1Full is string && data.course1Full.size() >= 1 && data.course1Full.size() <= 160
        && data.course1DurationDays is number && data.course1DurationDays >= 1 && data.course1DurationDays <= 1825
        && data.course2Id is string && (data.course2Id == '' || isValidId(data.course2Id))
        && data.course2Short is string && data.course2Short.size() <= 30
        && data.course2Full is string && data.course2Full.size() <= 160
        && data.course2DurationDays is number && data.course2DurationDays >= 0 && data.course2DurationDays <= 1825
        && data.totalDurationDays is number && data.totalDurationDays >= 1 && data.totalDurationDays <= 3650
        && isValidDateStr(data.joiningDate)
        && isValidOptionalDateStr(data.examDate)
        && data.contact is string && data.contact.size() >= 5 && data.contact.size() <= 30
        && data.completedSoftwares is list && data.completedSoftwares.size() <= 24
        && (data.completedSoftwares.size() == 0 || (data.completedSoftwares[0] is string && data.completedSoftwares[0].size() <= 60))
        && data.status in ['ongoing', 'completed']
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendance(data, studentId, dateStr) {
      return data.keys().hasAll([
          'trainerId', 'studentId', 'branch', 'date', 'status', 'remark', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'trainerId', 'studentId', 'branch', 'date', 'status', 'remark', 'createdAt', 'updatedAt'
        ])
        && data.trainerId is string && isValidId(data.trainerId)
        && data.studentId is string && data.studentId == studentId
        && data.branch in ['MAVELIKARA', 'KAYAMKULAM']
        && data.date is string && data.date == dateStr && isValidDateStr(data.date)
        && data.status in ['present', 'absent', 'late', 'excused']
        && data.remark is string && data.remark.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Trainers Directory
    match /trainers/{trainerId} {
      allow get: if isValidId(trainerId) && existing().name is string;
      allow list: if resource.data.dashboardConfigured in [true, false];
      allow create: if isValidId(trainerId)
        && isValidTrainer(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(trainerId)
        && isValidTrainer(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'designation', 'branches', 'branchSchedules', 'softwares',
            'dashboardConfigured', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'ongoingCount', 'completedCount', 'attendanceCount', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'dashboardConfigured', 'updatedAt'
          ])
        );
      allow delete: if isValidId(trainerId) && existing().name is string;

      // Credentials Subcollection (Split Collection)
      match /credentials/{credId} {
        allow get: if isValidId(trainerId) && credId == 'auth'
          && exists(/databases/$(database)/documents/trainers/$(trainerId));
        allow list: if false;
        allow create: if isValidId(trainerId) && credId == 'auth'
          && isValidTrainerCredentials(incoming(), trainerId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            exists(/databases/$(database)/documents/trainers/$(trainerId)) ||
            existsAfter(/databases/$(database)/documents/trainers/$(trainerId))
          );
        allow update: if isValidId(trainerId) && credId == 'auth'
          && isValidTrainerCredentials(incoming(), trainerId)
          && incoming().trainerId == existing().trainerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['passkeyHash', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'passkeyHash', 'recoveryQuestion', 'recoveryAnswerHash', 'updatedAt'
            ])
          );
        allow delete: if isValidId(trainerId) && credId == 'auth';
      }
    }

    // Courses Collection (Trainer-scoped)
    match /courses/{courseId} {
      allow get: if isValidId(courseId) && isValidId(existing().trainerId);
      allow list: if resource.data.trainerId is string && isValidId(resource.data.trainerId);
      allow create: if isValidId(courseId)
        && isValidCourse(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/trainers/$(incoming().trainerId));
      allow update: if isValidId(courseId)
        && isValidCourse(incoming())
        && incoming().trainerId == existing().trainerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'shortName', 'fullName', 'durationValue', 'durationUnit',
          'durationDays', 'softwares', 'updatedAt'
        ]);
      allow delete: if isValidId(courseId) && isValidId(existing().trainerId);
    }

    // Students Collection (Trainer-scoped)
    match /students/{studentId} {
      allow get: if isValidId(studentId) && isValidId(existing().trainerId);
      allow list: if resource.data.trainerId is string && isValidId(resource.data.trainerId);
      allow create: if isValidId(studentId)
        && isValidStudent(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/trainers/$(incoming().trainerId))
        && exists(/databases/$(database)/documents/courses/$(incoming().course1Id))
        && get(/databases/$(database)/documents/courses/$(incoming().course1Id)).data.trainerId == incoming().trainerId
        && (incoming().course2Id == '' || (
          exists(/databases/$(database)/documents/courses/$(incoming().course2Id))
          && get(/databases/$(database)/documents/courses/$(incoming().course2Id)).data.trainerId == incoming().trainerId
        ));
      allow update: if isValidId(studentId)
        && isValidStudent(incoming())
        && incoming().trainerId == existing().trainerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'regNo', 'name', 'branch', 'course1Id', 'course1Short', 'course1Full',
            'course1DurationDays', 'course2Id', 'course2Short', 'course2Full',
            'course2DurationDays', 'totalDurationDays', 'joiningDate',
            'examDate', 'contact', 'completedSoftwares', 'status', 'notes', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'completedSoftwares', 'status', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'examDate', 'notes', 'updatedAt'
          ])
        );
      allow delete: if isValidId(studentId) && isValidId(existing().trainerId);

      // Attendance Subcollection (Master Gate)
      match /attendance/{dateStr} {
        allow get: if isValidId(studentId) && isValidDateStr(dateStr) && isValidId(existing().trainerId);
        allow list: if resource.data.trainerId is string && isValidId(resource.data.trainerId);
        allow create: if isValidId(studentId)
          && isValidDateStr(dateStr)
          && isValidAttendance(incoming(), studentId, dateStr)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/students/$(studentId))
          && get(/databases/$(database)/documents/students/$(studentId)).data.trainerId == incoming().trainerId;
        allow update: if isValidId(studentId)
          && isValidDateStr(dateStr)
          && isValidAttendance(incoming(), studentId, dateStr)
          && incoming().trainerId == existing().trainerId
          && incoming().studentId == existing().studentId
          && incoming().date == existing().date
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/students/$(studentId))
          && get(/databases/$(database)/documents/students/$(studentId)).data.trainerId == incoming().trainerId
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'remark', 'branch', 'updatedAt'
          ]);
        allow delete: if isValidId(studentId)
          && isValidDateStr(dateStr)
          && exists(/databases/$(database)/documents/students/$(studentId));
      }
    }
  }
}
